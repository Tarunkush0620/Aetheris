# AETHERIS — Environment Configuration
# Copy this file to `.env` and fill in your keys.
# On Linux/Windows/macOS, use `.env` or standard shell environment variables.
#
# NOTE ON CLIENT-EXPOSED KEYS:
# GOOGLE_MAPS_API_KEY and CESIUM_ION_TOKEN are injected into the browser bundle
# by design for client-side WebGL rendering. Restrict them via provider consoles
# (HTTP referrer restrictions in Google Cloud / Cesium Ion).
# All other API keys stay securely server-side inside the local proxy.

# =============================================================================
# 1. 3D TILES & GLOBE (Primary Renderer)
# =============================================================================

# Required: Google Maps API key (with Map Tiles API enabled)
# Get a key: https://developers.google.com/maps/documentation/tile/cloud-setup
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Optional: Cesium Ion access token (for Cesium World Terrain & Bing imagery)
# Get a token: https://ion.cesium.com/tokens
CESIUM_ION_TOKEN=

# =============================================================================
# 2. AI VOICE & RECONNAISSANCE (OpenAI Realtime API)
# =============================================================================

# Optional: OpenAI API key for real-time voice commands and HUD AI analyst
# Get a key: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2
OPENAI_REALTIME_MODEL_MINI=gpt-realtime-2.1-mini
OPENAI_REALTIME_VOICE=marin
OPENAI_REALTIME_REASONING_EFFORT=low
OPENAI_REALTIME_CONTEXT_TOKENS=3000
OPENAI_REALTIME_CONTEXT_RETENTION=0.5
OPENAI_HUD_SUMMARY_MODEL=gpt-5-nano

# Optional: Rate limit for OpenAI endpoints (req/min per IP, default unlimited)
# AETHERIS_RATELIMIT_OPENAI_PER_MIN=30

# =============================================================================
# 3. LIVE AVIATION (OpenSky Network ADS-B)
# =============================================================================

# Optional: OpenSky authentication mode (oauth | basic | auto | anon)
# "oauth" uses OAuth2 credentials below; "anon" connects anonymously with rate limits.
OPENSKY_AUTH_MODE=oauth

# OpenSky OAuth2 Credentials (from https://opensky-network.org/ -> My Account)
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Optional: Path to OpenSky credentials JSON file (alternative to env vars above)
# OPENSKY_CREDENTIALS_FILE=./config/opensky_credentials.json

# =============================================================================
# 4. MARITIME & SUBSEA (AIS Live Vessels)
# =============================================================================

# Optional: AISStream API Key for real-time global ship positions (via WebSocket proxy)
# Get a free key: https://aisstream.io/
AISSTREAM_API_KEY=
VITE_AIS_LIVE_API_URL=/api/ais-live
VITE_AIS_LIVE_MAX_ROWS=12000
VITE_AIS_LIVE_LABEL_MAX_ROWS=900
# AISSTREAM_SILENCE_TIMEOUT_MS=120000

# =============================================================================
# 5. NATURAL HAZARDS & FIRES (NASA FIRMS)
# =============================================================================

# Optional: NASA FIRMS Map Key for live active wildfire thermal hotspots (VIIRS)
# Get a free map key: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# =============================================================================
# 6. ROAD TRAFFIC & TRANSIT (TomTom Traffic)
# =============================================================================

# Optional: TomTom API key for live real-time traffic flow vector tiles
# Get a free key (50,000 req/day): https://developer.tomtom.com/
TOMTOM_API_KEY=
TOMTOM_DAILY_TILE_BUDGET=40000

# =============================================================================
# 7. SERVER & NETWORKING
# =============================================================================

PORT=5173
# HOST=localhost  # Safe default: localhost only
# HOST=0.0.0.0    # Expose on local network (LAN)

# Rate limiting for Google Places search proxy (req/min per IP, default unlimited)
# AETHERIS_RATELIMIT_GOOGLE_PER_MIN=60

# =============================================================================
# 8. CCTV & OPTICAL TUNING (Advanced)
# =============================================================================

# CCTV_SOURCES_FILE=config/cctv_sources.austin.json
# CCTV_AUSTIN_MAX_SOURCES=36
# CCTV_MAX_SOURCES=48
# CCTV_AUTO_CALIBRATE=1
# CCTV_DRAPE_MESH=1
